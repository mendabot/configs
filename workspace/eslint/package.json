		"eslint-plugin-perfectionist": "^5.10.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-unicorn": "^74.0.0",
		"globals": "^17.10.0",
		"typescript-eslint": "^8.68.0"
	},
	"devDependencies": {
		"eslint": "^10.9.1",
		"prettier": "^3.9.6"
	},
	"peerDependencies": {
		"eslint": ">=10",
		"prettier": ">=3"
	},
