{
	"name": "@mendabot/eslint-config",
	"version": "0.0.2",
	"description": "ESLint config shared across our codebase",
	"keywords": [
		"eslint",
		"eslint-config",
		"eslintconfig",
		"prettier",
		"typescript"
	],
	"homepage": "https://github.com/mendabot/configs/tree/main/workspace/eslint#readme",
	"bugs": "https://github.com/mendabot/configs/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mendabot/configs.git",
		"directory": "workspace/eslint"
	},
	"license": "MIT",
	"author": "Mendabot <mendabot@pm.me>",
	"type": "module",
	"exports": {
		".": "./index.js"
	},
	"main": "index.js",
	"files": [
		"index.js"
	],
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
