{
	"name": "@mendabot/configs",
	"version": "0.0.1",
	"description": "Shared ESLint, Prettier and release configuration used across Mendabot projects.",
	"type": "module",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r dev",
		"clean": "pnpm -r clean",
		"lint": "pnpm run lint:prettier && pnpm run lint:root && pnpm -r lint",
		"lint:fix": "pnpm run lint:prettier:fix && pnpm run lint:root:fix && pnpm -r lint:fix",
		"lint:root": "eslint .",
		"lint:root:fix": "eslint . --fix",
		"lint:prettier": "prettier --ignore-path .gitignore --check '**/*.{json,yml,html,css}'",
		"lint:prettier:fix": "prettier --ignore-path .gitignore --check '**/*.{json,yml,html,css}' --write",
		"release": "semantic-release"
	},
	"devDependencies": {
		"@mendabot/eslint-config": "workspace:*",
		"@mendabot/prettier-config": "workspace:*",
		"@mendabot/release-scripts": "workspace:*",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.8.1",
		"prettier": "^3.9.6",
		"semantic-release": "^25.0.5"
	},
	"packageManager": "pnpm@10.33.1"
}
